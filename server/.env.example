PORT=4000

# Required in production — replace with a long random string
JWT_SECRET=replace-this-with-a-long-random-string

# Turso (libSQL) — required for Vercel deployment
# Get these from turso.tech after creating a free database
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-token-here
